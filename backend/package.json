{
  "name": "yencare-backend",
  "version": "1.0.0",
  "description": "YɛnCare backend — Express API, MongoDB patients, and SMS wrapper",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sms": "./src/sms/sendSms.js",
    "./models": "./src/models/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "sms:test": "node scripts/send-test-sms.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:dry": "node scripts/migrate.js --dry-run",
    "db:seed": "node scripts/seed.js",
    "db:seed:dry": "node scripts/seed.js --dry-run",
    "ops:slots": "node scripts/ensure-slots.js",
    "ops:reminders": "node scripts/send-reminders.js",
    "test": "node --test ./test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "yencare",
    "sms",
    "mongodb"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "africastalking": "^0.8.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4"
  }
}

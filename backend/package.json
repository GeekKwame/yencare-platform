{
  "name": "yencare-backend",
  "version": "1.0.0",
  "description": "YɛnCare backend — SMS wrapper, MongoDB models, and (later) Express API",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sms": "./src/sms/sendSms.js",
    "./models": "./src/models/index.js"
  },
  "scripts": {
    "sms:test": "node scripts/send-test-sms.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:dry": "node scripts/migrate.js --dry-run",
    "db:seed": "node scripts/seed.js",
    "db:seed:dry": "node scripts/seed.js --dry-run",
    "test": "node --test ./test/normalizePhone.test.js ./test/sendSms.test.js ./test/mnotify.test.js ./test/referenceCode.test.js ./test/models.test.js ./test/migration.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "yencare",
    "sms",
    "africastalking"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "africastalking": "^0.8.3",
    "dotenv": "^17.2.2",
    "mongoose": "^8.18.1"
  }
}

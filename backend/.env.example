# SMS provider: "mock" (default, offline) or "africastalking" (free sandbox)
SMS_PROVIDER=mock

# Africa's Talking sandbox (free). Username is ALWAYS "sandbox".
# Sign up: https://account.africastalking.com/apps/sandbox
# Simulator (where messages appear): https://simulator.africastalking.com:1517/
AT_USERNAME=sandbox
AT_API_KEY=
# Leave empty in sandbox unless you created an alphanumeric sender ID
AT_SENDER_ID=

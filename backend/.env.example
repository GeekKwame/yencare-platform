# Express API
PORT=4000

# MongoDB (required to run the API). Atlas URI or local:
# From backend/: docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27017/yencare

# Connection pool (staging card: min 10, max 50)
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=50

# Comma-separated browser origins allowed to call this API.
# Staging frontend: https://yencare-platform.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://yencare-platform.vercel.app
# Set to "false" to block yencare-platform-*.vercel.app preview URLs
CORS_ALLOW_VERCEL_PREVIEWS=true

# Staff portal JWT. Demo accounts: abena.osei@yencare.gh / kwame.boateng@yencare.gh /
# kojo.mensah@yencare.gh  password: yencare  (or STAFF_DEMO_PASSWORD)
JWT_SECRET=change-me-in-staging
STAFF_DEMO_PASSWORD=yencare

# SMS provider: "mock" (offline), "mnotify" (real Ghana phones), or "africastalking"
SMS_PROVIDER=mnotify

# mNotify — Ghana SMS. Sign up at https://www.mnotify.com/ (often ~50 free units).
# Dashboard → API v2 → Create API Key. Register sender ID "YenCare" (max 11 chars).
# Docs: https://readthedocs.mnotify.com/
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=YenCare

# Africa's Talking sandbox (optional). Username is ALWAYS "sandbox".
# Sign up: https://account.africastalking.com/apps/sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

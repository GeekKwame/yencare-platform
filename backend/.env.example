# Express API
PORT=4000

# MongoDB (required to run the API). Atlas URI or local:
# From backend/: docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27017/yencare

# Connection pool (staging card: min 10, max 50)
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=50

# Comma-separated browser origins allowed to call this API.
# Staging frontend: https://yencare-platform.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://yencare-platform.vercel.app
# Set to "false" to block yencare-platform-*.vercel.app preview URLs
CORS_ALLOW_VERCEL_PREVIEWS=true

# Staff portal JWT. Demo accounts: abena.osei@yencare.gh / kwame.boateng@yencare.gh /
# kojo.mensah@yencare.gh  password: yencare  (or STAFF_DEMO_PASSWORD)
JWT_SECRET=change-me-in-staging
STAFF_DEMO_PASSWORD=yencare

# Structured logs: debug | info | warn | error | silent (default info, silent in tests)
LOG_LEVEL=info

# Per-IP rate limits for the enumerable reference-code endpoints (requests/minute).
# Limits are active in every environment except test runs.
PUBLIC_LOOKUP_RATE_MAX=30
QUEUE_STATUS_RATE_MAX=120
QUEUE_STATUS_REFERENCE_RATE_MAX=30
# Escape hatch for load testing only:
# RATE_LIMIT_DISABLED=false

# Number of API instances. Real-time (SSE) updates use a process-local event bus,
# so anything above 1 refuses to boot in production until a shared bus is wired.
INSTANCE_COUNT=1

# SMS: "mock" locally, "mnotify" in production (only live provider)
SMS_PROVIDER=mnotify

# mNotify — Ghana SMS. Sign up at https://www.mnotify.com/
# Dashboard → API v2 → Create API Key. Register sender ID "YenCare" (max 11 chars).
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=YenCare
